@model cromosmundial_proyecto_final.Models.Cromo

@{
    ViewData["Title"] = "Eliminar Cromo";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none fw-bold text-secondary small d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> Cancelar y volver a la galería
                </a>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="row g-0">

                    <div class="col-12 col-md-5 bg-light d-flex flex-column align-items-center justify-content-center p-4 border-end border-light">
                        <span class="badge bg-danger bg-opacity-10 text-danger text-uppercase px-3 py-1.5 rounded-pill fw-bold mb-4" style="font-size: 0.7rem; letter-spacing: 0.5px; border: 1px solid rgba(220, 53, 69, 0.2);">
                            Elemento Seleccionado
                        </span>

                        <div class="card border-0 shadow-sm rounded-4 p-2.5 bg-white text-center" style="max-width: 220px; opacity: 0.85;">
                            <div class="position-relative overflow-hidden rounded-3">
                                @if (!string.IsNullOrEmpty(Model.RutaFoto))
                                {
                                    <img src="@Model.RutaFoto" alt="Cromo a eliminar" class="w-100 img-fluid" style="height: auto; max-height: 280px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted bg-light py-5" style="width: 200px; height: 260px;">
                                        <i class="bi bi-image fs-1 opacity-25 mb-2"></i>
                                        <span class="small fw-semibold opacity-50">Sin Foto</span>
                                    </div>
                                }
                            </div>
                            <div class="pt-3 pb-1">
                                <h4 class="fw-bold text-secondary mb-0" style="font-size: 1.1rem; letter-spacing: -0.5px;">@(Model.Jugador?.Nombre ?? "No Asignado")</h4>
                                <span class="badge bg-secondary bg-opacity-10 text-dark small fw-bold mt-2 px-2 py-0.5">
                                    #@Model.NumeroCamiseta
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-7 p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <div class="alert alert-danger border-0 rounded-3 p-3 mb-4 d-flex align-items-center" role="alert">
                                <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
                                <div>
                                    <h5 class="alert-heading fw-bold mb-0" style="font-size: 1rem;">¿Confirmas la eliminación?</h5>
                                    <p class="small mb-0 opacity-75">Esta acción borrará permanentemente el cromo de la base de datos local de manera irreversible.</p>
                                </div>
                            </div>

                            <h3 class="fw-bold text-dark mb-4" style="letter-spacing: -0.5px;">Resumen del Registro</h3>

                            <div class="bg-light rounded-3 p-4 border border-light">
                                <div class="row g-3">
                                    <div class="col-12 border-bottom border-2 border-white pb-2">
                                        <span class="text-muted small d-block fw-semibold text-uppercase" style="font-size: 0.65rem;">Jugador</span>
                                        <span class="text-dark fw-bold">@(Model.Jugador?.Nombre ?? "Sin asignar")</span>
                                    </div>
                                    <div class="col-6 border-end border-2 border-white pe-2">
                                        <span class="text-muted small d-block fw-semibold text-uppercase" style="font-size: 0.65rem;">Posición</span>
                                        <span class="text-dark fw-semibold small">@Model.Posicion</span>
                                    </div>
                                    <div class="col-6 ps-2">
                                        <span class="text-muted small d-block fw-semibold text-uppercase" style="font-size: 0.65rem;">Camiseta</span>
                                        <span class="text-dark fw-semibold small">#@Model.NumeroCamiseta</span>
                                    </div>
                                    <div class="col-12 border-top border-2 border-white pt-2">
                                        <span class="text-muted small d-block fw-semibold text-uppercase" style="font-size: 0.65rem;">Competición y Origen</span>
                                        <span class="text-muted small fw-medium">@(Model.Seleccion?.Nombre) — @(Model.Mundial?.Nombre)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-4 border-top border-light mt-5">
                            <form asp-action="Delete">
                                <input type="hidden" asp-for="Id" />
                                <div class="d-flex flex-column flex-sm-row gap-2">
                                    <button type="submit" class="btn btn-danger btn-lg flex-grow-1 fw-bold d-inline-flex align-items-center justify-content-center">
                                        <i class="bi bi-trash3-fill me-2"></i> Eliminar Definitivamente
                                    </button>
                                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>