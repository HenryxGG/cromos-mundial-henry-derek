@model cromosmundial_proyecto_final.Models.Cromo

@{
    ViewData["Title"] = "Detalles del Cromo";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none fw-bold text-secondary small d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la galería de cromos
                </a>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="row g-0">

                    <div class="col-12 col-md-5 bg-light d-flex flex-column align-items-center justify-content-center p-4 border-end border-light">
                        <span class="badge bg-dark text-uppercase px-3 py-1.5 rounded-pill fw-bold mb-4" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                            Cromo de Colección
                        </span>

                        <div class="card border-0 shadow rounded-4 p-2.5 bg-white text-center" style="max-width: 240px;">
                            <div class="position-relative overflow-hidden rounded-3 shadow-sm">
                                @if (!string.IsNullOrEmpty(Model.RutaFoto))
                                {
                                    <img src="@Model.RutaFoto" alt="Cromo Oficial" class="w-100 img-fluid" style="height: auto; max-height: 320px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted bg-light py-5" style="width: 220px; height: 290px;">
                                        <i class="bi bi-image fs-1 opacity-25 mb-2"></i>
                                        <span class="small fw-semibold opacity-50">Sin Foto</span>
                                    </div>
                                }
                            </div>
                            <div class="pt-3 pb-1">
                                <h4 class="fw-bold text-dark mb-0" style="font-size: 1.2rem; letter-spacing: -0.5px;">@(Model.Jugador?.Nombre ?? "No Asignado")</h4>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-7 p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <div class="mb-4">
                                <h2 class="fw-bold text-dark m-0" style="letter-spacing: -1px;">Especificaciones Técnicas</h2>
                                <p class="text-muted small m-0 mt-1">Ficha de metadatos asociada al registro de este jugador.</p>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <div class="p-3 bg-light rounded-3 h-100 border border-light">
                                        <span class="text-muted small d-block mb-1 fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Número de Camiseta</span>
                                        <div class="d-flex align-items-center text-dark fw-bold fs-5">
                                            <i class="bi bi-hash text-muted me-2"></i> @Model.NumeroCamiseta
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <div class="p-3 bg-light rounded-3 h-100 border border-light">
                                        <span class="text-muted small d-block mb-1 fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Posición en el Campo</span>
                                        <div class="d-flex align-items-center text-dark fw-bold fs-6">
                                            <i class="bi bi-person-badge text-muted me-2"></i>
                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold border-0 px-2.5 py-1">@Model.Posicion</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-3 border border-light">
                                        <span class="text-muted small d-block mb-1 fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Nombre del Jugador</span>
                                        <div class="d-flex align-items-center text-dark fw-bold fs-5">
                                            <i class="bi bi-person-fill text-muted me-2"></i> @(Model.Jugador?.Nombre ?? "Sin asignar")
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <div class="p-3 bg-light rounded-3 h-100 border border-light">
                                        <span class="text-muted small d-block mb-1 fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Selección Nacional</span>
                                        <div class="d-flex align-items-center text-dark fw-bold fs-6">
                                            <i class="bi bi-flag-fill text-muted me-2"></i> @(Model.Seleccion?.Nombre ?? "Sin asignar")
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <div class="p-3 bg-light rounded-3 h-100 border border-light">
                                        <span class="text-muted small d-block mb-1 fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Copa del Mundo</span>
                                        <div class="d-flex align-items-center text-dark fw-bold fs-6">
                                            <i class="bi bi-globe2 text-muted me-2"></i> @(Model.Mundial?.Nombre ?? "Sin asignar")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2 pt-4 border-top border-light mt-5">
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-lg flex-grow-1 fw-bold d-inline-flex align-items-center justify-content-center">
                                <i class="bi bi-pencil-square me-2"></i> Editar Información
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Volver al Listado</a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>