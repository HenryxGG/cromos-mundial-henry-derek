@model cromosmundial_proyecto_final.Models.Cromo

@{
    ViewData["Title"] = "Modificar Cromo";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none fw-bold text-secondary small d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la galería de cromos
                </a>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="row g-0">
                    
                    <div class="col-12 col-md-5 bg-light d-flex flex-column align-items-center justify-content-center p-4 border-end border-light">
                        <span class="badge bg-dark text-uppercase px-3 py-1.5 rounded-pill fw-bold mb-4 style="font-size: 0.7rem; letter-spacing: 0.5px;">
                            Vista del Cromo Oficial
                        </span>

                        <div class="card border-0 shadow-sm rounded-4 p-2 bg-white text-center" style="max-width: 220px;">
                            <div class="position-relative overflow-hidden rounded-3">
                                @if (!string.IsNullOrEmpty(Model.RutaFoto))
                                {
                                    <img src="@Model.RutaFoto" alt="Foto del Cromo" class="w-100 img-fluid" style="height: auto; max-height: 280px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted bg-light py-5" style="width: 200px; height: 260px;">
                                        <i class="bi bi-image fs-1 opacity-25 mb-2"></i>
                                        <span class="small fw-semibold opacity-50">Sin Foto</span>
                                    </div>
                                }
                            </div>
                            <div class="pt-3 pb-1">
                                <span class="d-block fw-bold text-dark mb-1">@Model.Jugador?.Nombre</span>
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1" style="font-size: 0.75rem;">
                                    Dorsal #@Model.NumeroCamiseta — @Model.Posicion
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-7 p-4 p-md-5">
                        <div class="mb-4">
                            <h2 class="fw-bold text-dark m-0" style="letter-spacing: -1px;">Configuración de la Ficha</h2>
                            <p class="text-muted small m-0 mt-1">Modifica las propiedades de la entidad seleccionada en la base de datos.</p>
                        </div>

                        <form asp-action="Edit" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                            <input type="hidden" asp-for="Id" />

                            <div class="row g-3 mb-4">
                                <div class="col-12 col-sm-6">
                                    <label asp-for="NumeroCamiseta" class="form-label fw-bold text-secondary small">Número de Camiseta</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;"><i class="bi bi-hash"></i></span>
                                        <input asp-for="NumeroCamiseta" class="form-control border-start-0 bg-light" style="border-radius: 0 8px 8px 0; box-shadow: none;" />
                                    </div>
                                    <span asp-validation-for="NumeroCamiseta" class="text-danger small d-block mt-1"></span>
                                </div>
                                
                                <div class="col-12 col-sm-6">
                                    <label asp-for="Posicion" class="form-label fw-bold text-secondary small">Posición de Campo</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;"><i class="bi bi-person-badge"></i></span>
                                        <input asp-for="Posicion" class="form-control border-start-0 bg-light" style="border-radius: 0 8px 8px 0; box-shadow: none;" />
                                    </div>
                                    <span asp-validation-for="Posicion" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="JugadorId" class="form-label fw-bold text-secondary small">Seleccionar Jugador</label>
                                <select asp-for="JugadorId" class="form-select bg-light py-2" style="border-radius: 8px; box-shadow: none; font-size: 0.95rem;" asp-items="@(ViewData["JugadorId"] as SelectList)"></select>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-12 col-sm-6">
                                    <label asp-for="SeleccionId" class="form-label fw-bold text-secondary small">Selección Nacional</label>
                                    <select asp-for="SeleccionId" class="form-select bg-light py-2" style="border-radius: 8px; box-shadow: none; font-size: 0.95rem;" asp-items="@(ViewData["SeleccionesId"] as SelectList)"></select>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <label asp-for="MundialId" class="form-label fw-bold text-secondary small">Evento Mundialista</label>
                                    <select asp-for="MundialId" class="form-select bg-light py-2" style="border-radius: 8px; box-shadow: none; font-size: 0.95rem;" asp-items="@(ViewData["MundialesId"] as SelectList)"></select>
                                </div>
                            </div>

                            <div class="mb-5 p-3 bg-light rounded-3 border border-light">
                                <label class="form-label fw-bold text-dark small mb-1"><i class="bi bi-cloud-upload me-1 text-primary"></i> Remplazar Imagen del Cromo</label>
                                <input asp-for="ArchivoFoto" type="file" class="form-control bg-white mt-1" style="border-radius: 6px; font-size: 0.85rem;" />
                                <span class="text-muted d-block mt-1" style="font-size: 0.7rem;">Dejar vacío si deseas conservar la foto actual.</span>
                            </div>

                            <div class="d-flex flex-column flex-sm-row gap-2 pt-3 border-top border-light">
                                <button type="submit" class="btn btn-primary btn-lg flex-grow-1 fw-bold">Guardar Cambios</button>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                            </div>

                        </form>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}