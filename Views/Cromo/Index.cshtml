@model IEnumerable<cromosmundial_proyecto_final.Models.Cromo>

@{
    ViewData["Title"] = "Galería de Cromos";
}

<div class="container-fluid px-4 py-5">

    <div class="row align-items-center mb-5">
        <div class="col-12 col-md-7 text-center text-md-start">
            <span class="badge bg-primary text-uppercase px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm" style="font-size: 0.75rem; letter-spacing: 1px; background: linear-gradient(45deg, #1e3c72, #2a5298) !important;">
                Álbum Digital Oficial
            </span>
            <h1 class="fw-black text-dark m-0 display-5" style="font-weight: 800; letter-spacing: -1px;">Mis Cromos</h1>
            <p class="text-muted text-truncate-1 m-0 mt-1">Explora, filtra y administra tu colección de cromos mundialistas.</p>
        </div>
        <div class="col-12 col-md-5 text-center text-md-end mt-4 mt-md-0">
            <a asp-action="Create" class="btn btn-primary btn-lg fw-bold d-inline-flex align-items-center">
                <i class="bi bi-plus-lg me-2"></i> Agregar a mi Colección
            </a>
        </div>
    </div>

    <div class="row mb-5 justify-content-center">
        <div class="col-12 col-lg-8">
            <form asp-action="Index" method="get" class="card-premium rounded-4 p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-sm-9">
                        <div class="input-group input-group-lg border-0">
                            <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="bi bi-search fs-5"></i></span>
                            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 bg-white fs-6" placeholder="¿Qué cromo buscas hoy? (Jugador, selección...)" style="box-shadow: none;" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Buscar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm p-3 mb-5 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-circle-fill me-3 fs-4 text-warning"></i>
            <div class="fw-medium">@ViewBag.Mensaje</div>
        </div>
    }

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 position-relative overflow-hidden card-premium transition-hover mx-auto" style="transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); max-width: 280px;">

                    <div class="position-absolute top-0 start-0 m-3 z-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-dark text-white fw-black rounded-3 px-2.5 py-1" style="font-size: 0.8rem; font-weight: 800; min-width: 32px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                            #@Html.DisplayFor(modelItem => item.NumeroCamiseta)
                        </span>
                    </div>


                    <div class="position-relative overflow-hidden text-center d-flex align-items-center justify-content-center w-100" style="background: rgba(255,255,255,0.02);">
                        @if (!string.IsNullOrEmpty(item.RutaFoto))
                        {
                            <img src="@item.RutaFoto" alt="Cromo de @item.Jugador?.Nombre" class="w-100 img-fluid" style="height: auto; max-height: 260px; object-fit: contain; background: rgba(0,0,0,0.03); padding: 8px; border-radius: 6px;" />
                        }
                        else
                        {
                            <div class="text-muted d-flex flex-column align-items-center justify-content-center py-5" style="height: 300px;">
                                <i class="bi bi-image-alt display-4 opacity-25 mb-2"></i>
                                <span class="small fw-semibold opacity-50">Sin Foto Oficial</span>
                            </div>
                        }
                        <div class="position-absolute bottom-0 start-0 w-100" style="height: 20px; background: linear-gradient(transparent, rgba(0,0,0,0.02));"></div>
                    </div>

                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="mb-3">
                            <h5 class="card-title fw-bold text-white mb-1 text-truncate" title="@item.Jugador?.Nombre" style="font-size: 1.05rem; letter-spacing: -0.5px;">
                                @(item.Jugador?.Nombre ?? "Jugador no asignado")
                            </h5>

                            <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                                <span class="d-inline-flex align-items-center text-muted-2 small fw-medium">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger opacity-75"></i> @item.Seleccion?.Nombre
                                </span>
                                <span class="ms-1 pos-badge-inline" title="@item.Posicion">@Html.DisplayFor(modelItem => item.Posicion)</span>

                                <span class="text-muted opacity-50">•</span>
                                <span class="d-inline-flex align-items-center text-muted small fw-medium">
                                    <i class="bi bi-globe2 me-1 text-primary opacity-75"></i> @item.Mundial?.Nombre
                                </span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-3 mt-2 border-top border-light">
                            <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                                <span class="text-muted opacity-25">&nbsp;</span>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Detalles</a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-5 pt-4">
        <nav aria-label="Paginación de Cromos">
            <ul class="pagination shadow-sm rounded-4 border-0 overflow-hidden">
                @{
                    int currentPage = ViewData["CurrentPage"] as int? ?? 1;
                    int totalPages = ViewData["TotalPages"] as int? ?? 1;
                    string currentFilter = ViewData["CurrentFilter"] as string ?? "";
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link border-0 px-4 py-2.5 fw-bold @(i == currentPage ? "bg-dark text-white" : "text-secondary bg-white")"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@currentFilter"
                           style="box-shadow: none; font-size: 0.9rem;">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<style>
    .transition-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08) !important;
    }

    .hover-primary:hover {
        text-decoration: underline !important;
        color: #0d6efd !important;
    }

    .hover-danger:hover {
        text-decoration: underline !important;
        color: #dc3545 !important;
    }

    .fw-black {
        font-weight: 800;
    }

    .text-truncate-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .pos-badge {
        display: inline-block;
        max-width: 90px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.65rem;
        padding: .28rem .5rem;
        background-color: rgba(25, 135, 84, 0.95);
        color: #fff;
        border: 1px solid rgba(0,0,0,0.06);
    }

    @@media (max-width: 576px) {
        .pos-badge { max-width: 64px; font-size: .6rem; }
        .card { max-width: 100% !important; }
    }

    .pos-badge-inline {
        display: inline-block;
        background: rgba(25,135,84,0.95);
        color: #fff;
        padding: .22rem .45rem;
        border-radius: .6rem;
        font-size: .72rem;
        font-weight:700;
        box-shadow: 0 6px 12px rgba(13,24,35,0.06);
    }

    .card-body .card-title { color: inherit; }
</style>