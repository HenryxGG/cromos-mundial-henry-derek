@model cromosmundial_proyecto_final.Models.Jugador

@{
    ViewData["Title"] = "Perfil del Jugador";
    // Obtenemos el cromo de la lista si existe usando la relación de navegación
    var cromoAsociado = Model.Cromos?.FirstOrDefault();
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none fw-bold text-secondary small d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la lista de jugadores
                </a>
            </div>

            <div class="card border-0 shadow rounded-3 overflow-hidden bg-white">
                <div class="row g-0">

                    <div class="col-12 col-md-5 bg-light d-flex flex-column align-items-center justify-content-center p-4">
                        <span class="badge bg-primary text-uppercase px-3 py-1.5 rounded-pill fw-bold mb-3">Cromo Vinculado</span>

                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white text-center mx-auto" style="max-width: 260px;">
                            <div class="position-relative overflow-hidden rounded-3 shadow-sm">
                                @if (cromoAsociado != null && !string.IsNullOrEmpty(cromoAsociado.RutaFoto))
                                {
                                    <img src="@cromoAsociado.RutaFoto" alt="Cromo Oficial" class="w-100 img-fluid" style="height: auto; max-height: 300px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted bg-light py-5" style="width: 200px; height: 260px;">
                                        <i class="bi bi-person-bounding-box display-4 opacity-25 mb-2"></i>
                                        <span class="small fw-semibold opacity-50 px-2">Sin Cromo Asignado</span>
                                    </div>
                                }
                            </div>
                            <div class="pt-3 pb-1">
                                <h5 class="fw-bold text-dark mb-0">@Model.Nombre</h5>
                                @if (cromoAsociado != null)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold mt-2">#@cromoAsociado.NumeroCamiseta — @cromoAsociado.Posicion</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-7 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="mb-3">
                                <h2 class="fw-bold text-dark m-0">Biografía del Jugador</h2>
                                <p class="text-muted small m-0 mt-1">Ficha de identidad e historia deportiva.</p>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <div class="p-3 bg-white rounded-3 h-100 border">
                                        <span class="text-muted small d-block mb-1 fw-semibold text-uppercase">Nacionalidad</span>
                                        <div class="d-flex align-items-center text-dark fw-bold"> <i class="bi bi-globe text-muted me-2"></i> @Model.Nacionalidad</div>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <div class="p-3 bg-white rounded-3 h-100 border">
                                        <span class="text-muted small d-block mb-1 fw-semibold text-uppercase">Fecha de Nacimiento</span>
                                        <div class="d-flex align-items-center text-dark fw-bold"> <i class="bi bi-calendar-event text-muted me-2"></i> @Model.FechaNacimiento.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="text-muted small d-block mb-2 fw-semibold text-uppercase">Trayectoria / Historia</span>
                                <div class="p-3 rounded-3 border" style="background-color: #f8f9fa; min-height: 140px; line-height: 1.6; font-size: 0.95rem; text-align: justify;">
                                    @if (!string.IsNullOrWhiteSpace(Model.Historia))
                                    {
                                        <p class="text-dark m-0" style="white-space: pre-line;">@Model.Historia</p>
                                    }
                                    else
                                    {
                                        <p class="text-muted m-0 small text-center py-3"> <i class="bi bi-file-earmark-text me-1"></i> No se ha redactado una historia para este jugador todavía.</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2 pt-3 border-top mt-4">
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-lg flex-grow-1">Editar Perfil e Historia</a>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Volver al Listado</a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .custom-history-box {
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
    }
</style>