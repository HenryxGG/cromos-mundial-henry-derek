@model cromosmundial_proyecto_final.Models.Jugador

@{
    ViewData["Title"] = "Editar Jugador";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none fw-bold text-secondary small d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado de jugadores
                </a>
            </div>

            <div class="card border-0 shadow rounded-3 bg-white p-3 p-md-4">

                <div class="mb-3 border-bottom pb-2">
                    <h2 class="fw-bold text-dark m-0">Modificar Perfil</h2>
                    <p class="text-muted small m-0 mt-1">Actualiza los datos de identidad y la trayectoria del jugador profesional.</p>
                </div>

                <form asp-action="Edit" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre Completo</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Lionel Messi" />
                        </div>
                        <div class="invalid-feedback d-block">
                            <span asp-validation-for="Nombre"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="FechaNacimiento" type="date" class="form-control" />
                            </div>
                            <div class="invalid-feedback d-block">
                                <span asp-validation-for="FechaNacimiento"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Nacionalidad" class="form-label">Nacionalidad</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-globe"></i></span>
                                <input asp-for="Nacionalidad" class="form-control" placeholder="Ej. Argentina" />
                            </div>
                            <div class="invalid-feedback d-block">
                                <span asp-validation-for="Nacionalidad"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Historia" class="form-label">Trayectoria / Historia del Jugador</label>
                        <textarea asp-for="Historia" class="form-control" rows="5" placeholder="Escribe la historia del jugador..."></textarea>
                        <div class="invalid-feedback d-block">
                            <span asp-validation-for="Historia"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2 pt-3 border-top border-light">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1 fw-bold"><i class="bi bi-check-circle-fill me-2"></i> Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-bold">Cancelar</a>
                    </div>

                </form>
            </div>

        </div><style>
        textarea.form-control::placeholder {
        color: #adb5bd !important;
        opacity: 0.8 !important;
        font-style: italic;
        }
    </style>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}