@model cromosmundial_proyecto_final.Models.Mundial

@{
    ViewData["Title"] = "Crear Mundial";
}

<div class="container my-5">
    <div class="card shadow-sm rounded-3 p-4">
        <h2 class="fw-bold">Nuevo Mundial</h2>
        <p class="text-muted small">Registra un nuevo torneo mundial</p>
        <hr />

        <form asp-action="Create" class="mt-3">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <div class="invalid-feedback d-block"><span asp-validation-for="Nombre"></span></div>
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <label asp-for="Anio" class="form-label">Año</label>
                    <input asp-for="Anio" class="form-control" />
                    <div class="invalid-feedback d-block"><span asp-validation-for="Anio"></span></div>
                </div>
                <div class="col-6">
                    <label asp-for="PaisSede" class="form-label">País sede</label>
                    <input asp-for="PaisSede" class="form-control" />
                    <div class="invalid-feedback d-block"><span asp-validation-for="PaisSede"></span></div>
                </div>
            </div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

            <div class="mb-3 mt-3">
                <label asp-for="Cromos" class="form-label">Cromos</label>
                <input asp-for="Cromos" class="form-control" />
                <div class="invalid-feedback d-block"><span asp-validation-for="Cromos"></span></div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
