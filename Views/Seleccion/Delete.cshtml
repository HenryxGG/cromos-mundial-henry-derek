@model cromosmundial_proyecto_final.Models.Seleccion

@{
    ViewData["Title"] = "Eliminar Selección";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <div class="card shadow-sm rounded-3 p-4">
                <h4 class="mb-2">Confirmar eliminación</h4>
                <p class="text-muted small">¿Deseas eliminar la selección <strong>@Html.DisplayFor(m => m.Nombre)</strong>?</p>

                <dl class="row mb-3">
                    <dt class="col-sm-4 text-muted">Confederación</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Confederacion)</dd>

                    <dt class="col-sm-4 text-muted">Director Técnico</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.DirectorTecnico)</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
