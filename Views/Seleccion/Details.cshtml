@model cromosmundial_proyecto_final.Models.Seleccion

@{
    ViewData["Title"] = "Detalle Selección";
}

<div class="container my-5">
    <div class="card shadow-sm rounded-3 p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="fw-bold mb-0">@Html.DisplayFor(m => m.Nombre)</h2>
                <small class="text-muted">Detalle de la selección</small>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-sm">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2">Volver</a>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-8">
                <dl class="row">
                    <dt class="col-sm-4 text-muted">Confederación</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Confederacion)</dd>

                    <dt class="col-sm-4 text-muted">Director Técnico</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.DirectorTecnico)</dd>
                </dl>
            </div>
            <div class="col-12 col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.RutaFoto))
                {
                    <img src="@Model.RutaFoto" alt="Foto de la Selección" class="img-fluid rounded-3 shadow-sm" style="max-height:150px;" />
                }
            </div>
        </div>
    </div>
</div>
