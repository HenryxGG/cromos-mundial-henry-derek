<!DOCTYPE html>
<html lang="es">
@await RenderSectionAsync("Styles", required: false)
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cromos Mundial</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        :root{
          --bg-page: #f6f8fb;
          --panel: #ffffff;
          --muted: #6c757d;
          --accent-gold: #d4af37;
          --accent-green: #23a455;
          --accent-qatari: #0e5bd8;
          --card-radius: 12px;
          --card-shadow: 0 8px 20px rgba(13,24,35,0.06);
          --soft-shadow: 0 6px 18px rgba(10,24,35,0.06);
          --radius-sm: 8px;
          --transition-fast: .18s ease;
          --font-sans: 'Inter', 'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
        }

        html,body { height:100%; }
        body {
            font-family: var(--font-sans);
            background: linear-gradient(180deg, var(--bg-page), #eef3f8 120%);
            color: #0b2233;
            -webkit-font-smoothing:antialiased;
            -moz-osx-font-smoothing:grayscale;
            margin:0; padding:0;
        }

        .app-navbar { background: rgba(255,255,255,0.9); border-bottom:1px solid rgba(13,24,35,0.04); box-shadow: var(--soft-shadow); }
        .navbar-brand { font-weight:700; letter-spacing:.3px; color: #0b2233 !important; }

        .app-sidebar { background: rgba(255,255,255,0.98); min-height:100vh; padding:1rem; width:260px; border-right:1px solid rgba(13,24,35,0.04); }
        .app-sidebar .nav-link { color: #0b2233; padding:.6rem .8rem; border-radius:.6rem; transition: background var(--transition-fast), transform var(--transition-fast); }
        .app-sidebar .nav-link:hover { background: rgba(14,24,36,0.03); transform: translateX(6px); }
        .app-sidebar .nav-link .bi { font-size:1.05rem; margin-right:.6rem; color:var(--accent-qatari); }

        .card-premium { background: linear-gradient(180deg, #ffffff, #fbfdff); border-radius:var(--card-radius); box-shadow:var(--card-shadow); border:1px solid rgba(13,24,35,0.04); color:#0b2233; }

        .btn-primary, .btn-primary:focus, .btn-primary:hover { background: linear-gradient(90deg,#f5d58b,var(--accent-gold)); border: none; color: rgba(10,10,10,0.95); box-shadow: 0 6px 20px rgba(212,175,55,0.08); transition: transform var(--transition-fast), box-shadow var(--transition-fast); }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(212,175,55,0.12); }
        .btn-ghost { background: transparent; border: 1px solid rgba(13,24,35,0.06); color: var(--muted); }
        .btn-ghost:hover { background: rgba(14,24,36,0.02); color: #0b2233; }

        .table-modern { background: transparent; border-collapse: separate; border-spacing: 0 10px; }
        .table-modern thead th { color: var(--muted); font-weight:600; border-bottom:none; }
        .table-modern tbody tr { background: #ffffff; border-radius:var(--radius-sm); box-shadow: 0 6px 12px rgba(13,24,35,0.04); transition: transform var(--transition-fast), box-shadow var(--transition-fast); }
        .table-modern tbody tr:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(13,24,35,0.06); }
        .table-modern td, .table-modern th { vertical-align: middle; border:none; padding:.9rem; }


        .btn {
            height: 44px;
            padding: 0 .9rem;
            border-radius: .7rem;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            font-weight: 600;
            transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
        }

        .btn-lg { height: 52px; padding: 0 1.1rem; font-size: 1rem; }
        .btn-sm { height: 36px; padding: 0 .6rem; font-size: .85rem; }


        .btn-primary {
            background: linear-gradient(90deg,#f5d58b,var(--accent-gold));
            border: none;
            color: rgba(10,10,10,0.95);
            box-shadow: 0 6px 18px rgba(212,175,55,0.08);
        }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(212,175,55,0.12); }
        .btn-primary:disabled, .btn-primary[disabled] { opacity: .6; transform: none; box-shadow: none; }


        .btn-danger { background: linear-gradient(90deg,#e44b4b,#c62828); color:#fff; border:none; }
        .btn-danger:hover { transform: translateY(-2px); }


        .btn-outline-secondary, .btn-outline-secondary:hover { background: transparent; border: 1px solid rgba(13,24,35,0.06); color: #0b2233; }


        .btn-light { background: rgba(0,0,0,0.03); color: #0b2233; border: 1px solid rgba(13,24,35,0.04); }


        .form-control, .form-select, textarea { background: #ffffff; border: 1px solid rgba(13,24,35,0.06); color: #0b2233; padding: .65rem .85rem; border-radius: .6rem; box-shadow: none; }
        .form-control:focus, .form-select:focus, textarea:focus { outline: none; box-shadow: 0 6px 18px rgba(14,24,36,0.06); border-color: var(--accent-qatari); }


        .input-group-text { background: transparent; border: none; color: var(--muted); }


        .table { border-collapse: separate; border-spacing: 0 10px; }
        .table thead th { color: var(--muted); border-bottom: none; background: transparent; }
        .table tbody tr { background: #fff; border-radius: .6rem; box-shadow: 0 6px 12px rgba(13,24,35,0.04); transition: transform var(--transition-fast); }
        .table tbody tr:hover { transform: translateY(-2px); }
        .table td, .table th { border: none; vertical-align: middle; padding: .85rem; }


        a.text-decoration-none { text-decoration: none !important; }
        .card .btn, .card a.btn { width: auto; }


        .app-footer { border-top:1px solid rgba(13,24,35,0.04); color:var(--muted); padding:1rem 0; font-size:.9rem; }


        .text-muted-2 { color: var(--muted); }
        .rounded-lg { border-radius: var(--card-radius) !important; }
        .fade-in { animation: fadeIn .45s ease both; }
        @@keyframes fadeIn { from { opacity:0; transform: translateY(6px);} to { opacity:1; transform: none; } }

        @@media (max-width:991px) { .app-sidebar { display:none; } .main-wrapper { padding-left:.75rem; padding-right:.75rem; } }
        .top-nav-wrapper { background: transparent; border-bottom:1px solid rgba(13,24,35,0.03); padding: .6rem 1rem; }
        .top-nav-wrapper .nav-link { color: #0b2233; padding: .5rem .8rem; border-radius: .5rem; transition: background var(--transition-fast); }
        .top-nav-wrapper .nav-link:hover { background: rgba(14,24,36,0.02); text-decoration: none; }

        .text-primary-strong { color: #0b3a5a !important; font-weight:700; }
    </style>
</head>
<body>
    <div class="d-flex flex-column" style="min-height:100vh;">

        <div class="container-fluid px-3 py-2 top-nav-wrapper d-none d-lg-block">
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Jugador" asp-action="Index" class="nav-link px-3 py-2"><i class="bi bi-people-fill me-1"></i> Jugadores</a>
                <a asp-controller="Seleccion" asp-action="Index" class="nav-link px-3 py-2"><i class="bi bi-flag-fill me-1"></i> Selecciones</a>
                <a asp-controller="Cromo" asp-action="Index" class="nav-link px-3 py-2"><i class="bi bi-images me-1"></i> Cromos</a>
                <a asp-controller="Mundial" asp-action="Index" class="nav-link px-3 py-2"><i class="bi bi-trophy-fill me-1"></i> Mundiales</a>
            </div>
        </div>


        <div class="flex-fill main-wrapper">

            <nav class="navbar navbar-expand-lg app-navbar px-3 py-2">
                <div class="container-fluid">
                    <div class="d-flex align-items-center">
                        <button id="sidebarToggle" class="btn btn-ghost me-2 d-lg-none" aria-label="Abrir menú"><i class="bi bi-list fs-3" style="color:#fff"></i></button>
                        <a asp-controller="Home" asp-action="Index" class="navbar-brand text-white me-3">Cromos Mundial</a>
                        <form class="d-none d-md-flex ms-2" asp-controller="Jugador" asp-action="Index" method="get">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-transparent border-0 text-muted"><i class="bi bi-search"></i></span>
                                <input class="form-control form-control-dark form-control-sm border-0" type="search" placeholder="Buscar jugadores, selecciones..." name="searchString" />
                            </div>
                        </form>
                    </div>

                    <div class="d-flex align-items-center">

                    </div>
                </div>
            </nav>


            <main class="main-container py-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>


            <footer class="app-footer text-center">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-md-12 small text-muted-2">&copy; @DateTime.Now.Year Cromos Mundial • Diseño inspirado en eventos deportivos</div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function(){
            const btn = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('sidebar');
            btn && btn.addEventListener('click', function(){
                if(!sidebar) return;
                if (getComputedStyle(sidebar).display === 'none') {
                    sidebar.style.display = 'block';
                    sidebar.classList.add('fade-in');
                } else {
                    sidebar.style.display = 'none';
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
